#!/usr/bin/env python3
"""decanter — a bottle manager for Windows applications on Apple Silicon macOS.

A bottle is a Wine prefix plus its metadata: which Windows version to pretend to be,
which environment variables the application needs, which graphics backend to use.
This is the layer the Mac Wine ecosystem has been missing for non-game software.
"""

from __future__ import annotations

import argparse
import json
import os
import filecmp
import shutil
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.1.0"

HOME = Path(os.environ.get("DECANTER_HOME", Path.home() / ".local" / "share" / "decanter"))


def default_runtime() -> Path:
    """Where the runtime is.

    A packaged app carries one inside itself, and that is the one it should use: it is the
    runtime the app was built and tested against, and it works on a machine with no checkout
    and no Homebrew. A checkout uses the one `bootstrap-runtime.sh` installed.
    """
    bundled = Path(__file__).resolve().parent.parent / "runtime"
    if (bundled / "bin" / "wine").is_file():
        return bundled
    return HOME / "runtime"


RUNTIME = Path(os.environ.get("DECANTER_RUNTIME") or default_runtime())
BOTTLES = HOME / "bottles"
RECIPES = Path(__file__).resolve().parent.parent / "recipes"

WINDOWS_VERSIONS = {"win7": "win7", "win10": "win10", "win11": "win11"}

# Which layer serves which Direct3D version. Wine itself handles everything older than
# Direct3D 9, and Direct3D 12 always goes through vkd3d-proton: Wine's own cannot make a device
# here, because DXGI is DXMT's or DXVK's.
GRAPHICS = {
    "dxmt": {
        "summary": "Direct3D 10 and 11 straight to Metal; 9 through DXVK; 12 through vkd3d-proton",
        "backends": {"9": "DXVK on KosmicKrisp", "10": "DXMT on Metal", "11": "DXMT on Metal",
                     "12": "vkd3d-proton on KosmicKrisp"},
    },
    "dxvk": {
        "summary": "Direct3D 9, 10 and 11 through DXVK on KosmicKrisp; 12 through vkd3d-proton",
        "backends": {"9": "DXVK on KosmicKrisp", "10": "DXVK on KosmicKrisp",
                     "11": "DXVK on KosmicKrisp", "12": "vkd3d-proton on KosmicKrisp"},
    },
}
DEFAULT_GRAPHICS = "dxmt"


def graphics_of(meta: dict) -> str:
    """A bottle's backend, with the older name for the default folded in.

    Bottles made before the choice meant anything say "wined3d", which was never what they got:
    the layers are installed as builtins, and Wine's own Direct3D was never in play for 9 to 12.
    """
    name = meta.get("graphics", DEFAULT_GRAPHICS)
    return name if name in GRAPHICS else DEFAULT_GRAPHICS


def fail(message: str) -> None:
    print(f"decanter: {message}", file=sys.stderr)
    raise SystemExit(1)


def bottle_dir(name: str) -> Path:
    return BOTTLES / name


def load(name: str) -> dict:
    meta = bottle_dir(name) / "bottle.json"
    if not meta.is_file():
        fail(f"no bottle named {name!r} (see: decanter bottle list)")
    return json.loads(meta.read_text())


def save(meta: dict) -> None:
    path = bottle_dir(meta["name"]) / "bottle.json"
    path.write_text(json.dumps(meta, indent=2) + "\n")


def runtime_bin() -> Path:
    binary = RUNTIME / "bin" / "wine"
    if not binary.is_file():
        fail(
            f"no runtime at {RUNTIME}\n"
            "  build one with: scripts/bootstrap-runtime.sh --dev"
        )
    return binary


def vulkan_library() -> str:
    """Which Vulkan library Wine was built to open.

    configure prefers the Khronos loader and falls back to MoltenVK. The difference is not
    cosmetic: the loader honours VK_DRIVER_FILES and can be pointed at the runtime's own
    driver, while MoltenVK is opened directly and ignores it, which silently changes which
    extensions a program sees. A Wine built before vulkan-loader was installed takes the
    fallback, so say so.
    """
    binary = RUNTIME / "lib" / "wine" / "aarch64-unix" / "win32u.so"
    if not binary.is_file():
        return "unknown"
    try:
        names = subprocess.run(["strings", str(binary)], capture_output=True,
                               text=True, errors="replace").stdout.split("\n")
    except OSError:
        return "unknown"
    for name in ("libvulkan.1.dylib", "libMoltenVK.dylib"):
        if name in names:
            return name + ("" if name.startswith("libvulkan") else
                           "  (Khronos loader bypassed: rebuild with vulkan-loader installed)")
    return "unknown"


def runtime_variant() -> str:
    """dev builds move Windows' low addresses above 4 GB; release builds need the entitlement."""
    marker = RUNTIME / "variant"
    return marker.read_text().strip() if marker.is_file() else "unknown"


def runtime_has(*relative: str) -> bool:
    return all((RUNTIME / part).exists() for part in relative)


def stage_graphics(meta: dict) -> None:
    """Put the graphics DLLs where the prefix will find them.

    Wine links its builtins into a prefix when the prefix is made, so anything installed
    into the runtime afterwards has to be copied in by hand. Doing it on every run is
    cheap and keeps a bottle working after the runtime gains a layer.
    """
    system32 = bottle_dir(meta["name"]) / "prefix" / "drive_c" / "windows" / "system32"
    if not system32.is_dir():
        return
    backend = graphics_of(meta)

    # Direct3D 12 always goes through vkd3d-proton, and DXVK's DXGI is what presents for its
    # command queues, under the name DXMT's DXGI loads it by.
    wants = [
        (RUNTIME / "vkd3d-proton" / "x64" / "d3d12.dll", system32 / "d3d12.dll"),
        (RUNTIME / "vkd3d-proton" / "x64" / "d3d12core.dll", system32 / "d3d12core.dll"),
        (RUNTIME / "dxvk" / "x64" / "dxgi.dll", system32 / "dxgi_dxvk.dll"),
        # Direct3D 9 goes through DXVK whichever backend is chosen: Wine's own needs a GL
        # context, which is a longer path to the same Metal device.
        (RUNTIME / "dxvk" / "x64" / "d3d9.dll", system32 / "d3d9.dll"),
    ]

    if backend == "dxvk":
        # DXVK for 10 and 11 as well, which means its DXGI has to be the one in play: DXVK's
        # d3d11 will not run on anyone else's.
        wants += [
            (RUNTIME / "dxvk" / "x64" / "d3d11.dll", system32 / "d3d11.dll"),
            (RUNTIME / "dxvk" / "x64" / "d3d10core.dll", system32 / "d3d10core.dll"),
            (RUNTIME / "dxvk" / "x64" / "dxgi.dll", system32 / "dxgi.dll"),
        ]
    else:
        # Back to DXMT for 10 and 11. This has to *replace* what a previous run may have staged
        # from DXVK rather than delete it: Wine does not fall back to its builtin when the file
        # in the prefix is missing, it fails to resolve the import at all.
        for name in ("d3d11.dll", "d3d10core.dll", "dxgi.dll"):
            builtin = RUNTIME / "lib" / "wine" / "aarch64-windows" / name
            if builtin.is_file():
                wants.append((builtin, system32 / name))

    for source, destination in wants:
        if not source.is_file():
            continue
        if destination.is_file() and filecmp.cmp(source, destination, shallow=True):
            continue
        shutil.copy2(source, destination)


def base_env(meta: dict) -> dict:
    """A clean environment, so host secrets never reach Windows processes.

    Mirrors what Hadron's own launch script does: Wine is started from a minimal
    environment rather than inheriting whatever the terminal happens to hold.
    """
    prefix = bottle_dir(meta["name"]) / "prefix"
    # Libraries the runtime carries for itself come first; Homebrew is a fallback for a runtime
    # built in a checkout, and a packaged one does not need it at all.
    library_path = str(RUNTIME / "ext" / "lib") + ":/opt/homebrew/lib"
    if runtime_has("mesa-zink/lib/libEGL.1.dylib"):
        library_path = f"{RUNTIME / 'mesa-zink' / 'lib'}:{library_path}"

    env = {
        "HOME": str(Path.home()),
        "USER": os.environ.get("USER", "user"),
        "LANG": os.environ.get("LANG", "en_US.UTF-8"),
        "TMPDIR": os.environ.get("TMPDIR", "/tmp"),
        "PATH": f"{RUNTIME / 'bin'}:/usr/bin:/bin:/usr/sbin:/sbin",
        "WINEPREFIX": str(prefix),
        "WINEDEBUG": os.environ.get("DECANTER_WINEDEBUG", ""),
        "WINEDLLOVERRIDES": "mscoree,mshtml=",
        # The runtime does not carry FreeType or GnuTLS; they come from arm64 Homebrew.
        "DYLD_FALLBACK_LIBRARY_PATH": library_path,
        "FEX_DISKCACHE": "1",
    }

    icd = RUNTIME / "mesa" / "share" / "vulkan" / "icd.d" / "kosmickrisp_mesa_icd.aarch64.json"
    if icd.is_file():
        # KosmicKrisp, Mesa's Vulkan on Metal. MoltenVK, which the loader would find
        # otherwise, cannot create an instance under Wine.
        env["VK_DRIVER_FILES"] = str(icd)
        env["MESA_KK_EXPERIMENTAL"] = "dgc,xfb,sparse"

    if runtime_has("mesa-zink/lib/libEGL.1.dylib") and icd.is_file():
        # OpenGL: Wine's Mac driver uses Zink on KosmicKrisp through EGL. Apple's own
        # OpenGL stops at 4.1 and is not used.
        env["WINE_MAC_OPENGL"] = "egl"
        env["MESA_LOADER_DRIVER_OVERRIDE"] = "zink"
        env["DRIRC_CONFIGDIR"] = str(RUNTIME / "mesa-zink" / "share" / "drirc.d")

    backend = graphics_of(meta)
    # Wine loads its own builtin for any of these unless told to prefer the copy in the bottle.
    if backend == "dxvk":
        env["WINEDLLOVERRIDES"] = env["WINEDLLOVERRIDES"] + ";d3d9,d3d11,d3d10core,dxgi=n"
    else:
        env["WINEDLLOVERRIDES"] = env["WINEDLLOVERRIDES"] + ";d3d9=n"
    if runtime_has("vkd3d-proton/x64/d3d12.dll"):
        env["WINEDLLOVERRIDES"] = env["WINEDLLOVERRIDES"] + ";d3d12,d3d12core=n"
        cache = prefix / "shadercache"
        cache.mkdir(parents=True, exist_ok=True)
        env["VKD3D_SHADER_CACHE_PATH"] = str(cache)

    env.update(meta.get("env", {}))
    return env


def ensure_prefix(meta: dict) -> None:
    prefix = bottle_dir(meta["name"]) / "prefix"
    if (prefix / "drive_c").is_dir():
        return
    print(f"decanter: creating prefix for {meta['name']} (first run takes a moment)")
    subprocess.run([str(runtime_bin()), "wineboot", "-u"], env=base_env(meta), check=False)
    apply_windows_version(meta)
    stage_graphics(meta)


def apply_windows_version(meta: dict) -> None:
    version = WINDOWS_VERSIONS.get(meta.get("windows", "win10"), "win10")
    subprocess.run(
        [str(runtime_bin()), "winecfg", "-v", version],
        env=base_env(meta),
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


# --- commands -------------------------------------------------------------------


def cmd_doctor(args: argparse.Namespace) -> None:
    print(f"decanter {VERSION}")
    print(f"  host          {os.uname().machine} / macOS {os.uname().release}")
    print(f"  home          {HOME}")
    print(f"  runtime       {RUNTIME} ({runtime_variant()})")
    if not (RUNTIME / "bin" / "wine").is_file():
        print("  runtime       MISSING — run scripts/bootstrap-runtime.sh --dev")
        return
    version = subprocess.run(
        [str(RUNTIME / "bin" / "wine"), "--version"], capture_output=True, text=True
    ).stdout.strip()
    print(f"  wine          {version}")
    emulators = RUNTIME / "lib" / "wine" / "aarch64-windows"
    for dll, what in (("xtajit64.dll", "x86-64 (ARM64EC)"), ("xtajit.dll", "32-bit x86 (WoW64)")):
        present = "yes" if (emulators / dll).is_file() else "no"
        print(f"  emulator      {what:<20} {present}")

    # Which Vulkan library Wine opens decides everything about graphics: with the Khronos
    # loader, VK_DRIVER_FILES is honoured and the runtime's own driver is used; with the
    # MoltenVK fallback that configure picks when vulkan-loader is absent at build time, the
    # loader is bypassed entirely and the driver is whatever MoltenVK offers.
    print(f"  vulkan        {vulkan_library()}")

    if runtime_variant() == "dev":
        print("  note          dev runtime: 64-bit Windows programs only")
    print(f"  bottles       {len(list(BOTTLES.glob('*/bottle.json')))}")


def cmd_bottle_create(args: argparse.Namespace) -> None:
    directory = bottle_dir(args.name)
    if (directory / "bottle.json").is_file():
        fail(f"bottle {args.name!r} already exists")
    directory.mkdir(parents=True, exist_ok=True)
    meta = {
        "name": args.name,
        "created": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "windows": args.windows,
        "graphics": args.graphics,
        "env": {},
        "programs": [],
    }
    save(meta)
    print(f"created bottle {args.name!r}")
    if args.init:
        ensure_prefix(meta)


def cmd_bottle_list(args: argparse.Namespace) -> None:
    names = sorted(p.parent.name for p in BOTTLES.glob("*/bottle.json"))
    if not names:
        print("no bottles")
        return
    for name in names:
        meta = load(name)
        programs = len(meta.get("programs", []))
        print(f"{name:<20} {meta.get('windows', '?'):<6} {meta.get('graphics', '?'):<8} {programs} program(s)")


# Variables the runtime computes for every bottle. Setting one of these in a bottle shadows
# what the runtime worked out, which is occasionally what you want and more often a leftover
# from a debugging session -- and the result is a program that quietly gets a different
# library than the runtime intended. Two afternoons went that way.
COMPUTED_ENV = (
    "DYLD_FALLBACK_LIBRARY_PATH",
    "VK_DRIVER_FILES",
    "VK_ICD_FILENAMES",
    "WINE_MAC_OPENGL",
    "MESA_LOADER_DRIVER_OVERRIDE",
    "MESA_KK_EXPERIMENTAL",
    "DRIRC_CONFIGDIR",
    "WINEDLLOVERRIDES",
)


def cmd_bottle_info(args: argparse.Namespace) -> None:
    meta = load(args.name)
    print(json.dumps(meta, indent=2))
    backend = graphics_of(meta)
    print()
    print(f"graphics: {backend} — {GRAPHICS[backend]['summary']}")
    for version in sorted(GRAPHICS[backend]["backends"], key=int):
        print(f"  Direct3D {version:<3} {GRAPHICS[backend]['backends'][version]}")
    print("  older       Wine itself")
    shadows = sorted(set(meta.get("env", {})) & set(COMPUTED_ENV))
    if shadows:
        print()
        print("note: these override what the runtime computed for this bottle:")
        for key in shadows:
            print(f"  {key}={meta['env'][key]}")
        print("  (remove one with: decanter env <bottle> NAME=)")


def cmd_bottle_set(args: argparse.Namespace) -> None:
    meta = load(args.name)
    changed = []
    if args.windows:
        meta["windows"] = args.windows
        changed.append(f"windows={args.windows}")
    if args.graphics:
        meta["graphics"] = args.graphics
        changed.append(f"graphics={args.graphics}")
    if not changed:
        fail("nothing to change: pass --windows or --graphics")
    save(meta)
    print(f"updated {args.name!r}: " + ", ".join(changed))
    if args.windows:
        apply_windows_version(meta)


def cmd_bottle_rm(args: argparse.Namespace) -> None:
    directory = bottle_dir(args.name)
    if not (directory / "bottle.json").is_file():
        fail(f"no bottle named {args.name!r}")
    if not args.force:
        answer = input(f"delete bottle {args.name!r} and everything installed in it? [y/N] ")
        if answer.lower() not in ("y", "yes"):
            print("kept")
            return
    shutil.rmtree(directory)
    print(f"deleted bottle {args.name!r}")


def cmd_run(args: argparse.Namespace) -> None:
    meta = load(args.bottle)
    ensure_prefix(meta)
    stage_graphics(meta)
    executable = args.executable
    if Path(executable).is_file() and not executable.lower().endswith(".exe"):
        fail("expected a Windows executable")
    command = [str(runtime_bin()), executable, *args.arguments]
    print(f"decanter: {' '.join(command)}")
    raise SystemExit(subprocess.run(command, env=base_env(meta)).returncode)


def cmd_install(args: argparse.Namespace) -> None:
    meta = load(args.bottle)
    installer = Path(args.installer).expanduser().resolve()
    if not installer.is_file():
        fail(f"no such file: {installer}")
    ensure_prefix(meta)
    print(f"decanter: running {installer.name} in bottle {args.bottle!r}")
    code = subprocess.run([str(runtime_bin()), str(installer)], env=base_env(meta)).returncode
    if code == 0:
        meta.setdefault("programs", []).append({"installer": str(installer), "when": time.strftime("%Y-%m-%dT%H:%M:%S")})
        save(meta)
    raise SystemExit(code)


def cmd_env(args: argparse.Namespace) -> None:
    meta = load(args.bottle)
    if not args.assignments:
        for key, value in sorted(meta.get("env", {}).items()):
            print(f"{key}={value}")
        return
    for assignment in args.assignments:
        key, _, value = assignment.partition("=")
        if not value:
            # An empty value removes the variable. Setting it to the empty string would
            # override whatever the runtime computed, which is how "unset VK_DRIVER_FILES"
            # once turned into "tell the Vulkan loader to load no driver at all".
            meta.get("env", {}).pop(key, None)
            continue
        meta.setdefault("env", {})[key] = value
    save(meta)
    print(f"updated {args.bottle!r}")


def cmd_shortcut(args: argparse.Namespace) -> None:
    meta = load(args.bottle)
    shortcuts = meta.setdefault("shortcuts", [])

    if args.shortcut_command == "list":
        if not shortcuts:
            print("no shortcuts")
        for entry in shortcuts:
            extra = " " + " ".join(entry.get("args", []))
            print(f"{entry['name']:<24} {entry['path']}{extra}")
        return

    if args.shortcut_command == "add":
        shortcuts[:] = [s for s in shortcuts if s["name"] != args.name]
        entry = {"name": args.name, "path": args.path}
        # Some programs need flags to start under Wine at all; a shortcut is where they belong,
        # so that launching it does not mean remembering them.
        if args.arguments:
            entry["args"] = args.arguments
        shortcuts.append(entry)
        shortcuts.sort(key=lambda s: s["name"].lower())
        save(meta)
        print(f"added {args.name!r} to {args.bottle!r}")
        return

    if args.shortcut_command == "rm":
        before = len(shortcuts)
        shortcuts[:] = [s for s in shortcuts if s["name"] != args.name]
        if len(shortcuts) == before:
            fail(f"no shortcut named {args.name!r}")
        save(meta)
        print(f"removed {args.name!r} from {args.bottle!r}")
        return

    if args.shortcut_command == "suggest":
        # List the executables a bottle has, so the window can offer them. Windows paths,
        # because that is what the program will be started with.
        prefix = bottle_dir(args.bottle) / "prefix" / "drive_c"
        found = []
        for directory in ("Program Files", "Program Files (x86)"):
            root = prefix / directory
            if not root.is_dir():
                continue
            for path in root.rglob("*.exe"):
                relative = path.relative_to(prefix)
                found.append("C:\\" + str(relative).replace("/", "\\"))
        for item in sorted(found)[: args.limit]:
            print(item)
        return


def cmd_recipe_list(args: argparse.Namespace) -> None:
    for path in sorted(RECIPES.glob("*.json")):
        recipe = json.loads(path.read_text())
        status = recipe.get("status", "untested")
        print(f"{path.stem:<16} [{status:<8}] {recipe.get('description', '')}")


def import_into_bottle(meta: dict, source: Path, target: str) -> None:
    """Put a Windows-visible copy of a downloaded file where the bottle can run it."""
    destination = bottle_dir(meta["name"]) / "prefix" / "drive_c" / "decanter" / target
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)


def cmd_recipe_apply(args: argparse.Namespace) -> None:
    path = RECIPES / f"{args.recipe}.json"
    if not path.is_file():
        fail(f"no recipe named {args.recipe!r} (see: decanter recipe list)")
    recipe = json.loads(path.read_text())
    meta = load(args.bottle)
    ensure_prefix(meta)
    print(f"decanter: applying {args.recipe!r} ({recipe.get('status', 'untested')}) to {args.bottle!r}")

    for step in recipe["steps"]:
        if "download" in step:
            target = step.get("as") or Path(step["download"]).name
            print(f"  fetching {step['download']}")
            subprocess.run(["curl", "-fL", "--retry", "3", "-o", str(HOME / target), step["download"]], check=False)
            import_into_bottle(meta, HOME / target, target)
        elif "run" in step:
            # Installers that take their own command line should say so in the recipe, so a
            # recipe can be non-interactive instead of waiting for someone to click Next.
            arguments = step.get("args", [])
            print(f"  running {step['run']} {' '.join(arguments)} — {step.get('note', '')}".rstrip(" —"))
            subprocess.run([str(runtime_bin()), step["run"], *arguments],
                           env=base_env(meta), check=False)
        elif "set" in step:
            key, value = step["set"]
            meta.setdefault("env", {})[key] = value
            save(meta)
        elif "windows" in step:
            meta["windows"] = step["windows"]
            save(meta)
            apply_windows_version(meta)
    print(f"applied recipe {args.recipe!r} to {args.bottle!r}")


# --- argument parsing -----------------------------------------------------------


def main() -> None:
    parser = argparse.ArgumentParser(prog="decanter", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"decanter {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor", help="check the runtime and report versions").set_defaults(func=cmd_doctor)

    bottle = sub.add_parser("bottle", help="manage bottles")
    bottle_sub = bottle.add_subparsers(dest="bottle_command", required=True)

    create = bottle_sub.add_parser("create", help="create a bottle")
    create.add_argument("name")
    create.add_argument("--windows", default="win10", choices=sorted(WINDOWS_VERSIONS))
    create.add_argument("--graphics", default=DEFAULT_GRAPHICS, choices=sorted(GRAPHICS))
    create.add_argument("--init", action="store_true", help="create the prefix now instead of on first use")
    create.set_defaults(func=cmd_bottle_create)

    bottle_sub.add_parser("list", help="list bottles").set_defaults(func=cmd_bottle_list)

    info = bottle_sub.add_parser("info", help="show a bottle's metadata")
    info.add_argument("name")
    info.set_defaults(func=cmd_bottle_info)

    set_cmd = bottle_sub.add_parser("set", help="change a bottle's settings")
    set_cmd.add_argument("name")
    set_cmd.add_argument("--windows", choices=sorted(WINDOWS_VERSIONS))
    set_cmd.add_argument("--graphics", choices=sorted(GRAPHICS))
    set_cmd.set_defaults(func=cmd_bottle_set)

    rm = bottle_sub.add_parser("rm", help="delete a bottle")
    rm.add_argument("name")
    rm.add_argument("--force", action="store_true")
    rm.set_defaults(func=cmd_bottle_rm)

    run = sub.add_parser("run", help="run a Windows program in a bottle")
    run.add_argument("bottle")
    run.add_argument("executable", help="Windows path, e.g. 'C:\\\\Program Files\\\\Vendor\\\\app.exe'")
    run.add_argument("arguments", nargs=argparse.REMAINDER)
    run.set_defaults(func=cmd_run)

    install = sub.add_parser("install", help="run an installer in a bottle")
    install.add_argument("bottle")
    install.add_argument("installer")
    install.set_defaults(func=cmd_install)

    env = sub.add_parser("env", help="get or set a bottle's environment variables")
    env.add_argument("bottle")
    env.add_argument("assignments", nargs="*", help="NAME=value to set, NAME to unset")
    env.set_defaults(func=cmd_env)

    shortcut = sub.add_parser("shortcut", help="programs to launch with one click")
    shortcut_sub = shortcut.add_subparsers(dest="shortcut_command", required=True)
    shortcut_list = shortcut_sub.add_parser("list", help="list shortcuts")
    shortcut_list.add_argument("bottle")
    shortcut_list.set_defaults(func=cmd_shortcut)
    shortcut_add = shortcut_sub.add_parser("add", help="add a shortcut")
    shortcut_add.add_argument("bottle")
    shortcut_add.add_argument("name")
    shortcut_add.add_argument("path", help="Windows path, e.g. 'C:\\\\Program Files\\\\Vendor\\\\app.exe'")
    shortcut_add.add_argument("--args", dest="arguments", nargs=argparse.REMAINDER, default=[],
                              help="arguments to launch it with")
    shortcut_add.set_defaults(func=cmd_shortcut)
    shortcut_rm = shortcut_sub.add_parser("rm", help="remove a shortcut")
    shortcut_rm.add_argument("bottle")
    shortcut_rm.add_argument("name")
    shortcut_rm.set_defaults(func=cmd_shortcut)
    shortcut_suggest = shortcut_sub.add_parser("suggest", help="list executables in a bottle")
    shortcut_suggest.add_argument("bottle")
    shortcut_suggest.add_argument("--limit", type=int, default=40)
    shortcut_suggest.set_defaults(func=cmd_shortcut)

    recipe = sub.add_parser("recipe", help="apply a known configuration")
    recipe_sub = recipe.add_subparsers(dest="recipe_command", required=True)
    recipe_sub.add_parser("list", help="list recipes").set_defaults(func=cmd_recipe_list)
    apply = recipe_sub.add_parser("apply", help="apply a recipe to a bottle")
    apply.add_argument("bottle")
    apply.add_argument("recipe")
    apply.set_defaults(func=cmd_recipe_apply)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
