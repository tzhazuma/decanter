+   if (getenv("MESA_KK_TRACE"))
+      fprintf(stderr, "kosmickrisp: debug_flags=%#" PRIx64 " experimental_flags=%#" PRIx64 "\n",
+              (uint64_t)kk_mesa_debug_flags, (uint64_t)kk_mesa_experimental_flags);
