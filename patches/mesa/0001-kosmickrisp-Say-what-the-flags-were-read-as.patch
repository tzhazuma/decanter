 #include "kk_debug.h"
+#include <inttypes.h>
+#include <stdio.h>
 #include "util/u_debug.h"
 
 enum kk_debug kk_mesa_debug_flags = 0;
@@ -36,4 +38,11 @@ kk_process_debug_variable(void)
 {
    kk_mesa_debug_flags = debug_get_option_mesa_kk_debug();
    kk_mesa_experimental_flags = debug_get_option_mesa_kk_experimental();
+
+   /* Say what was read, on demand. Whether these flags take effect in a given process is
+    * otherwise invisible from outside, and it is the first thing worth knowing when a
